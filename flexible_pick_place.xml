    <!-- Free components, declared AFTER the arm so their freejoint qpos live at the
         end of qpos (keyframe layout: 10 robot values first, then 7 per component).
         Collision layer = simple primitives (physics); visual layer = separate
         geoms that can later be upgraded to textures/meshes without touching
         physics. -->
    <body name="relay_1" pos="0.24 0.32 0.121">
      <freejoint name="relay_1_free"/>
      <geom name="relay_1_col" class="component_collision" type="box" size="0.015 0.012 0.020" mass="0.06"/>
      <geom name="relay_1_vis" class="component_visual" type="box" size="0.015 0.012 0.020" material="relay_blue"/>
      <geom name="relay_1_vis_top" class="component_visual" type="box" size="0.010 0.008 0.002" pos="0 0 0.021" material="off_white"/>
    </body>
    <body name="relay_2" pos="0.24 0.44 0.121">
      <freejoint name="relay_2_free"/>
      <geom name="relay_2_col" class="component_collision" type="box" size="0.015 0.012 0.020" mass="0.06"/>
      <geom name="relay_2_vis" class="component_visual" type="box" size="0.015 0.012 0.020" material="relay_blue_light"/>
      <geom name="relay_2_vis_top" class="component_visual" type="box" size="0.010 0.008 0.002" pos="0 0 0.021" material="off_white"/>
    </body>
    <body name="terminal_1" pos="0.36 0.44 0.111" quat="0.7071068 0 0 0.7071068">
      <freejoint name="terminal_1_free"/>
      <geom name="terminal_1_col" class="component_collision" type="box" size="0.040 0.008 0.010" mass="0.04"/>
      <geom name="terminal_1_vis" class="component_visual" type="box" size="0.040 0.008 0.010" material="terminal_gray"/>
      <geom name="terminal_1_vis_top" class="component_visual" type="box" size="0.036 0.005 0.002" pos="0 0 0.011" material="black"/>
    </body>
    <body name="button_1" pos="0.36 0.32 0.112">
      <freejoint name="button_1_free"/>
      <!-- Box collision with a wide footprint: real button modules mount on a square
           base; a pure cylinder tips too easily after release. Visual stays cylindrical. -->
      <geom name="button_1_col" class="component_collision" type="box" size="0.016 0.016 0.011" mass="0.02"
            friction="1.4 0.01 0.001"/>
      <geom name="button_1_vis" class="component_visual" type="cylinder" size="0.011 0.009" pos="0 0 0.002" material="button_module_red"/>
      <geom name="button_1_vis_top" class="component_visual" type="cylinder" size="0.007 0.002" pos="0 0 0.012" material="off_white"/>
    </body>
  </worldbody>

  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5"/>
      <joint joint="finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- Logical grasp attachments: one pre-declared weld per component, enabled at
         runtime with the measured hand-object relative pose. -->
    <weld name="grasp_relay_1" body1="hand" body2="relay_1" active="false" solref="0.004 1"/>
    <weld name="grasp_relay_2" body1="hand" body2="relay_2" active="false" solref="0.004 1"/>
    <weld name="grasp_terminal_1" body1="hand" body2="terminal_1" active="false" solref="0.004 1"/>
    <weld name="grasp_button_1" body1="hand" body2="button_1" active="false" solref="0.004 1"/>
  </equality>

  <actuator>
    <position class="fr3" name="fr3_joint1" joint="fr3_joint1" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint2" joint="fr3_joint2" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint3" joint="fr3_joint3" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint4" joint="fr3_joint4" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint5" joint="fr3_joint5" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint6" joint="fr3_joint6" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint7" joint="fr3_joint7" kp="2000" kv="200"/>
    <position name="wrist_spin" joint="wrist_spin" kp="800" kv="80" ctrlrange="-1000000 1000000" forcerange="-40 40"/>
    <general name="gripper" tendon="split" dyntype="none" gaintype="fixed" biastype="affine" forcerange="-500 500" ctrlrange="0 255" gainprm="0.01568627451 0 0" biasprm="0 -100 -10"/>
  </actuator>

  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
