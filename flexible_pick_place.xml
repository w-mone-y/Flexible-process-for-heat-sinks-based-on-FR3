          <geom contype="1" conaffinity="1" type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445" condim="6" friction="20 2 1" solref="0.012 1" solimp="0.95 0.99 0.001"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom contype="1" conaffinity="1" type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05" condim="6" friction="20 2 1" solref="0.012 1" solimp="0.95 0.99 0.001"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom contype="1" conaffinity="1" type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05" condim="6" friction="20 2 1" solref="0.012 1" solimp="0.95 0.99 0.001"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom contype="1" conaffinity="1" type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395" condim="6" friction="20 2 1" solref="0.012 1" solimp="0.95 0.99 0.001"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom contype="1" conaffinity="1" type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395" condim="6" friction="20 2 1" solref="0.012 1" solimp="0.95 0.99 0.001"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04" damping="10" armature="0.01" frictionloss="0"/>
      </default>
    </default>
    <!-- Static workcell furniture: collides with both the robot (bit 1) and the
         components (bit 2). -->
    <default class="workcell">
      <geom type="box" contype="3" conaffinity="3" friction="1.0 0.005 0.0001"/>
    </default>
    <!-- Free components: collide with the environment and each other (bit 2) but
         NOT with the robot/fingers (bit 1). Grasping is a logical weld attach, so
         finger closing is a visual animation and must never push components away. -->
    <default class="component_collision">
      <geom contype="2" conaffinity="2" condim="4" friction="1.0 0.005 0.0001" group="3"/>
    </default>
    <!-- Component visual layer: swap freely for textures/meshes later without
         touching physics. -->
    <default class="component_visual">
      <geom density="0" contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

