<?xml version="1.0" encoding="utf-8"?>
<mujoco model="heat_sink_brazing_line">
  <!--
    MVP cell for a low-voltage cabinet heat-sink brazing demonstration.
    Dimensions and thermal behaviour are demonstrator defaults, not process data.

    The three robots are independent attachments of the upstream FR3 asset.  The
    prefixes are part of the public scene contract used by brazing_sim.motion.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic"
          gravity="0 0 -9.81" impratio="5"/>

  <default>
    <geom friction="1.0 0.01 0.001" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    <default class="cell">
      <geom type="box" contype="1" conaffinity="1" rgba="0.42 0.45 0.50 1"/>
    </default>
    <default class="product">
      <geom type="box" contype="2" conaffinity="3" condim="4"
            friction="1.2 0.01 0.001" solref="0.006 1"/>
    </default>
    <default class="marker">
      <geom contype="0" conaffinity="0" density="0" group="1"/>
      <site group="1"/>
    </default>
  </default>

  <asset>
    <model name="fr3_asset" file="franka_fr3/fr3.xml"/>
    <texture name="floor_tex" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.18 0.22 0.26" rgb2="0.12 0.15 0.18" mark="edge" markrgb="0.35 0.38 0.42"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="aluminium" rgba="0.73 0.76 0.80 1" specular="0.75" shininess="0.7"/>
    <material name="tray_mat" rgba="0.20 0.24 0.29 1" metallic="0.45" roughness="0.42"/>
    <material name="fixture_mat" rgba="0.15 0.32 0.47 1" metallic="0.30" roughness="0.50"/>
    <material name="braze_mat" rgba="0.94 0.55 0.10 0.90" emission="0.15"/>
    <material name="furnace_mat" rgba="0.20 0.22 0.25 1" metallic="0.35" roughness="0.55"/>
    <material name="hot_mat" rgba="0.90 0.22 0.06 0.40" emission="0.45"/>
    <material name="tool_blue" rgba="0.10 0.38 0.78 1"/>
    <material name="tool_yellow" rgba="0.92 0.67 0.10 1"/>
  </asset>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.25 0.25 0.25"/>
    <global azimuth="90" elevation="-28"/>
    <rgba haze="0.10 0.14 0.18 1"/>
  </visual>

  <worldbody>
    <light pos="0 0.40 2.2" dir="0 0 -1" directional="true" diffuse="0.85 0.85 0.82"/>
    <light pos="-1.2 -0.8 1.4" dir="0.5 0.5 -1" diffuse="0.35 0.38 0.45"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"
          contype="1" conaffinity="3"/>

    <!-- Software-owned shared zones.  Sites remain visual-only. -->
    <site name="zone_assembly_fixture" type="box" pos="0 0.45 0.185" size="0.29 0.22 0.002"
          rgba="0.20 0.75 0.95 0.11" group="1"/>
    <site name="zone_brazing" type="box" pos="0 0.45 0.34" size="0.31 0.24 0.15"
          rgba="0.95 0.58 0.12 0.06" group="1"/>
    <site name="zone_furnace_mouth" type="box" pos="-0.25 -0.81 0.31" size="0.22 0.18 0.18"
          rgba="0.95 0.28 0.12 0.08" group="1"/>
    <site name="zone_inspection" type="box" pos="0.60 -0.25 0.30" size="0.23 0.18 0.14"
          rgba="0.25 0.90 0.40 0.07" group="1"/>

    <!-- MOCAP goals used by the independent arm controllers. -->
    <body name="arm1_target" mocap="true" pos="-0.35 0.25 0.59" quat="0 0.967157 0.254180 0">
      <geom class="marker" name="arm1_target_marker" type="sphere" size="0.018" rgba="0.95 0.25 0.20 0.35"/>
    </body>
    <body name="arm2_target" mocap="true" pos="0 0.13 0.59" quat="0 0.923880 0.382683 0">
      <geom class="marker" name="arm2_target_marker" type="sphere" size="0.018" rgba="0.20 0.75 0.95 0.35"/>
