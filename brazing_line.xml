    <frame pos="-0.62 0.10 0" euler="0 0 0.514">
      <attach model="fr3_asset" body="base" prefix="arm1_"/>
    </frame>
    <frame pos="0 -0.18 0" euler="0 0 1.57079632679">
      <attach model="fr3_asset" body="base" prefix="arm2_"/>
    </frame>
    <frame pos="0.62 0.10 0" euler="0 0 2.628">
      <attach model="fr3_asset" body="base" prefix="arm3_"/>
    </frame>

