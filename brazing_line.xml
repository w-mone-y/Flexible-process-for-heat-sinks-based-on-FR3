      <site name="arm3_inspection_tcp" pos="0 0 0.065" size="0.004" rgba="0.25 0.9 0.4 1"/>
      <camera name="arm3_wrist_camera" pos="0 0 0.055" euler="3.14159265359 0 0" fovy="52"/>
