<mujoco model="fr3 scene with gripper target and grasp objects fixed">
  <!-- Put this file in franka_fr3/ together with fr3_with_gripper_full_close_visual_toggle.xml -->
  <include file="fr3_with_gripper_full_close_visual_toggle.xml"/>

  <statistic center="0.45 0 0.35" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="object_table_mat" rgba="0.38 0.34 0.30 1" specular="0.15" shininess="0.2"/>
    <material name="target_table_mat" rgba="0.30 0.34 0.32 1" specular="0.15" shininess="0.2"/>
    <material name="target_zone1_green" rgba="0.10 0.90 0.25 0.28" specular="0.1" shininess="0.1"/>
    <material name="target_zone1_border" rgba="0.00 0.95 0.20 0.90" specular="0.1" shininess="0.1"/>
    <material name="target_zone2_red" rgba="1.00 0.08 0.06 0.30" specular="0.1" shininess="0.1"/>
    <material name="target_zone2_border" rgba="1.00 0.02 0.02 0.92" specular="0.1" shininess="0.1"/>
    <material name="grasp_cube_blue" rgba="0.15 0.45 1.0 1" specular="0.25" shininess="0.35"/>
    <material name="grasp_cylinder_orange" rgba="1.0 0.45 0.10 1" specular="0.25" shininess="0.35"/>
    <material name="wheel_table_mat" rgba="0.34 0.32 0.40 1" specular="0.15" shininess="0.2"/>
    <material name="wheel_support_mat" rgba="0.46 0.46 0.50 1" specular="0.2" shininess="0.25"/>
    <material name="wheel_cylinder_mat" rgba="0.95 0.20 0.16 1" specular="0.3" shininess="0.4"/>
    <material name="wheel_marker_mat" rgba="1.00 0.95 0.05 1" specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.2 0.1 0.01"/>

    <!-- Mocap target. Your controller uses body name="target". -->
    <body name="target" pos="0.45 0 0.45" quat="0 1 0 0" mocap="true">
      <geom name="target_box" type="box" size="0.025 0.025 0.025" contype="0" conaffinity="0" rgba="0.6 0.3 0.3 0.35" group="1"/>
      <site name="target_site" type="sphere" size="0.007" rgba="0 0 1 1" group="1"/>
      <geom name="target_axis_x" type="capsule" fromto="0 0 0 0.09 0 0" size="0.003" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_y" type="capsule" fromto="0 0 0 0 0.09 0" size="0.003" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_z" type="capsule" fromto="0 0 0 0 0 0.09" size="0.003" rgba="0 0.35 1 1" contype="0" conaffinity="0" group="1"/>
    </body>

    <!-- A small fixed table places objects above the robot base/floor and away from initial self-collision. -->
    <geom name="grasp_object_table" type="box" pos="0.62 0 0.160" size="0.17 0.24 0.020"
          material="object_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>

    <!-- A second fixed table to the robot's left side, separated from the front grasp table. -->
    <geom name="target_table" type="box" pos="0 0.62 0.160" size="0.30 0.18 0.020"
          material="target_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>

    <!-- Visual-only target zones on the target table top. They do not affect contacts. -->
    <geom name="target_zone1" type="box" pos="-0.12 0.62 0.181" size="0.050 0.050 0.001"
          material="target_zone1_green" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone1_border_front" type="box" pos="-0.068 0.62 0.183" size="0.002 0.052 0.002"
          material="target_zone1_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone1_border_back" type="box" pos="-0.172 0.62 0.183" size="0.002 0.052 0.002"
          material="target_zone1_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone1_border_left" type="box" pos="-0.12 0.568 0.183" size="0.052 0.002 0.002"
          material="target_zone1_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone1_border_right" type="box" pos="-0.12 0.672 0.183" size="0.052 0.002 0.002"
          material="target_zone1_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone2" type="box" pos="0.12 0.62 0.181" size="0.050 0.050 0.001"
          material="target_zone2_red" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone2_border_front" type="box" pos="0.172 0.62 0.183" size="0.002 0.052 0.002"
          material="target_zone2_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone2_border_back" type="box" pos="0.068 0.62 0.183" size="0.002 0.052 0.002"
          material="target_zone2_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone2_border_left" type="box" pos="0.12 0.568 0.183" size="0.052 0.002 0.002"
          material="target_zone2_border" contype="0" conaffinity="0" group="1"/>
    <geom name="target_zone2_border_right" type="box" pos="0.12 0.672 0.183" size="0.052 0.002 0.002"
          material="target_zone2_border" contype="0" conaffinity="0" group="1"/>

    <!-- A right-side table with a motorized ferris-wheel-like rotor. -->
    <geom name="wheel_table" type="box" pos="0 -0.62 0.160" size="0.30 0.18 0.020"
          material="wheel_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>
    <geom name="wheel_support" type="box" pos="0 -0.62 0.260" size="0.030 0.035 0.080"
          material="wheel_support_mat" contype="0" conaffinity="0"/>
    <body name="wheel_rotor" pos="0 -0.62 0.340">
      <joint name="wheel_hinge" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
      <geom name="wheel_cylinder" type="cylinder" size="0.075 0.018" quat="0.7071068 -0.7071068 0 0"
            material="wheel_cylinder_mat" mass="0.020" friction="0 0 0" condim="6" priority="2"
            contype="1" conaffinity="1" margin="0.001"
            solref="0.003 1" solimp="0.99 0.999 0.0001"/>
      <geom name="wheel_rotation_marker" type="capsule" fromto="0 -0.020 0 0 -0.020 0.070" size="0.004"
            material="wheel_marker_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Graspable cube: 4 cm edge. Table top is z=0.180, half-height is 0.020, plus 0.5 mm clearance. -->
    <body name="grasp_cube" pos="0.62 -0.075 0.2005" quat="0 1 0 0">
      <freejoint name="grasp_cube_freejoint"/>
      <geom name="grasp_cube_geom" type="box" size="0.020 0.020 0.020" material="grasp_cube_blue"
            mass="0.045" friction="4.0 0.12 0.01" condim="6" priority="1" contype="1" conaffinity="1"
            solref="0.012 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Graspable cylinder: 4 cm diameter, 5 cm height. Table top is z=0.180, half-height is 0.025, plus 0.5 mm clearance. -->
    <body name="grasp_cylinder" pos="0.62 0.075 0.2055" quat="0 1 0 0">
      <freejoint name="grasp_cylinder_freejoint"/>
      <geom name="grasp_cylinder_geom" type="cylinder" size="0.020 0.025" material="grasp_cylinder_orange"
            mass="0.040" friction="4.0 0.12 0.01" condim="6" priority="1" contype="1" conaffinity="1"
            solref="0.012 1" solimp="0.95 0.99 0.001"/>
    </body>

    <body name="grasp_ellipsoid" pos="0.62 0 0.2055" quat="0 1 0 0">
      <freejoint name="grasp_ellipsoid_freejoint"/>
      <geom name="grasp_ellipsoid_geom" type="ellipsoid" size="0.01 0.05 0.05" />
    </body>
  </worldbody>

  <actuator>
    <velocity name="wheel_spin" joint="wheel_hinge" kv="5.0" ctrlrange="-8 8"/>
  </actuator>
</mujoco>
