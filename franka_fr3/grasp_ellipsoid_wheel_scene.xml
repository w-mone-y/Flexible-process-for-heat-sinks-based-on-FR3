<mujoco model="fr3 ellipsoid wheel scene">
  <!-- Put this file in franka_fr3/ together with fr3_with_gripper_full_close_visual_toggle_axis_cylinder.xml -->
  <include file="fr3_with_gripper_full_close_visual_toggle_axis_cylinder.xml"/>

  <statistic center="0.45 0 0.35" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="object_table_mat" rgba="0.38 0.34 0.30 1" specular="0.15" shininess="0.2"/>
    <material name="grasp_ellipsoid_purple" rgba="0.55 0.20 0.90 1" specular="0.25" shininess="0.35"/>
    <mesh name="double_sphere_overlap_mesh" file="../../双球重叠体.STL" scale="0.001 0.001 0.001"/>
    <material name="wheel_table_mat" rgba="0.34 0.32 0.40 1" specular="0.15" shininess="0.2"/>
    <material name="wheel_support_mat" rgba="0.46 0.46 0.50 1" specular="0.2" shininess="0.25"/>
    <material name="wheel_cylinder_mat" rgba="0.95 0.20 0.16 1" specular="0.3" shininess="0.4"/>
    <material name="wheel_marker_mat" rgba="1.00 0.95 0.05 1" specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.2 0.1 0.01"/>

    <!-- Mocap target. Your controller uses body name="target". -->
    <body name="target" pos="0.45 0 0.45" quat="0 1 0 0" mocap="true">
      <geom name="target_box" type="box" size="0.025 0.025 0.025" contype="0" conaffinity="0" rgba="0.6 0.3 0.3 0.35" group="1"/>
      <site name="target_site" type="sphere" size="0.007" rgba="0 0 1 1" group="1"/>
      <geom name="target_axis_x" type="capsule" fromto="0 0 0 0.09 0 0" size="0.003" rgba="1 0 0 1" density="0" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_y" type="capsule" fromto="0 0 0 0 0.09 0" size="0.003" rgba="0 1 0 1" density="0" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_z" type="capsule" fromto="0 0 0 0 0 0.09" size="0.003" rgba="0 0.35 1 1" density="0" contype="0" conaffinity="0" group="1"/>
    </body>

    <!-- A small fixed table places objects above the robot base/floor and away from initial self-collision. -->
    <geom name="grasp_object_table" type="box" pos="0.62 0 0.160" size="0.17 0.24 0.020"
          material="object_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>

    <!-- Polishing Wheel 1 -->
    <!-- A right-side table with a motorized polishing wheel. -->
    <!-- Wheel center x=0.000 y=-0.620 z=0.340, radius=0.150; its lower edge stays 0.010 above the table top. -->
    <geom name="wheel_table" type="box" pos="0 -0.62 0.160" size="0.060 0.036 0.020"
          material="wheel_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>
    <geom name="wheel_support" type="box" pos="0 -0.62 0.260" size="0.030 0.035 0.080"
          material="wheel_support_mat" contype="0" conaffinity="0"/>
    <body name="wheel_rotor" pos="0 -0.62 0.340">
      <joint name="wheel_hinge" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
      <geom name="wheel_cylinder" type="cylinder" size="0.150 0.018" quat="0.7071068 -0.7071068 0 0"
            material="wheel_cylinder_mat" mass="0.080" friction="0 0 0" condim="6" priority="2"
            contype="1" conaffinity="1" margin="0.001"
            solref="0.003 1" solimp="0.99 0.999 0.0001"/>
      <geom name="wheel_rotation_marker" type="capsule" fromto="0 -0.020 0 0 -0.020 0.145" size="0.004"
            material="wheel_marker_mat" density="0" contype="0" conaffinity="0"/>
    </body>

    <!-- Polishing Wheel 2 -->
    <!-- An origin-mirrored table with a perpendicular motorized polishing wheel. -->
    <!-- This wheel center is x=0.000 y=0.720 z=0.500 and its rotation axis is parallel to world X. -->
    <geom name="wheel_table_opposite" type="box" pos="0 0.720 0.320" size="0.060 0.036 0.020"
          material="wheel_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>
    <geom name="wheel_support_opposite" type="box" pos="0 0.720 0.420" size="0.030 0.035 0.080"
          material="wheel_support_mat" contype="0" conaffinity="0"/>
    <body name="wheel_rotor_opposite" pos="0 0.720 0.500">
      <joint name="wheel_hinge_opposite" type="hinge" axis="1 0 0" damping="0.02" armature="0.001"/>
      <geom name="wheel_cylinder_opposite" type="cylinder" size="0.150 0.018" quat="0.7071068 0 0.7071068 0"
            material="wheel_cylinder_mat" mass="0.080" friction="0 0 0" condim="6" priority="2"
            contype="1" conaffinity="1" margin="0.001"
            solref="0.003 1" solimp="0.99 0.999 0.0001"/>
      <geom name="wheel_rotation_marker_opposite" type="capsule" fromto="-0.020 0 0 -0.020 0 0.145" size="0.004"
            material="wheel_marker_mat" density="0" contype="0" conaffinity="0"/>
    </body>

    <!-- Virtual lens workpiece. Its body xyz axes initially match the world xyz axes. -->
    <!-- Use the ellipsoid to replace the biconvex lens.
     The radius of the Sphere is 72.5 millimeters.
     The distance of the two centers of the sphere is 52.5 millimeters.
     -->
    <body name="grasp_ellipsoid" pos="0.62 0 0.2305" quat="1 0 0 0" gravcomp="1">
      <freejoint name="grasp_ellipsoid_freejoint"/>
      <!-- MuJoCo requires a nonzero inertial placeholder for a freejoint body;
           every visible workpiece geom below remains zero-density and non-colliding. -->
      <inertial pos="0 0 0" mass="0.000001" diaginertia="0.000000001 0.000000001 0.000000001"/>
      <geom name="grasp_ellipsoid_geom" type="ellipsoid" size="0.050 0.050 0.020" quat="0.7071068 0 -0.7071068 0"
            material="grasp_ellipsoid_purple" rgba="0.55 0.20 0.90 0" density="0"
            contype="0" conaffinity="0"/>
      <geom name="grasp_ellipsoid_visual_mesh" type="mesh" mesh="double_sphere_overlap_mesh"
            pos="-0.02 -0.05 -0.05" quat="1 0 0 0"
            material="grasp_ellipsoid_purple" density="0" contype="0" conaffinity="0" group="2"/>
      <geom name="grasp_ellipsoid_axis_origin" type="sphere" size="0.006" rgba="1 1 1 1" density="0"
            contype="0" conaffinity="0" group="1"/>
      <!-- Three coordinate axes.
        Axis_x:RED 
        Axis_y:GREEN
        Axis_z:BLUE 
        -->
      <geom name="grasp_ellipsoid_axis_x" type="capsule" fromto="0 0 0 0.15 0 0" size="0.003" density="0"
            rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="grasp_ellipsoid_axis_y" type="capsule" fromto="0 0 0 0 0.080 0" size="0.003" density="0"
            rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="grasp_ellipsoid_axis_z" type="capsule" fromto="0 0 0 0 0 0.080" size="0.003" density="0"
            rgba="0 0.35 1 1" contype="0" conaffinity="0" group="1"/>
    <!-- The handle of the ellipsoid . 
     The radius of the handle is slightly less smaller than the radius of the cylinder on the axis_z at the end of the robotic arm -->
      <geom name="grasp_ellipsoid_handle" type="cylinder" fromto="0 0 0 0 0 0.10" size="0.005"
            material="grasp_ellipsoid_purple" density="0" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="wheel_spin" joint="wheel_hinge" kv="5.0" ctrlrange="-8 8"/>
    <velocity name="wheel_spin_opposite" joint="wheel_hinge_opposite" kv="5.0" ctrlrange="-8 8"/>
  </actuator>
</mujoco>
