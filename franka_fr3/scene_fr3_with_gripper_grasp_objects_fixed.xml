<mujoco model="fr3 scene with gripper target and grasp objects fixed">
  <!-- Put this file in franka_fr3/ together with fr3_with_gripper_full_close_visual_toggle.xml -->
  <include file="fr3_with_gripper_full_close_visual_toggle.xml"/>

  <statistic center="0.45 0 0.35" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="object_table_mat" rgba="0.38 0.34 0.30 1" specular="0.15" shininess="0.2"/>
    <material name="grasp_cube_blue" rgba="0.15 0.45 1.0 1" specular="0.25" shininess="0.35"/>
    <material name="grasp_cylinder_orange" rgba="1.0 0.45 0.10 1" specular="0.25" shininess="0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.2 0.1 0.01"/>

    <!-- Mocap target. Your controller uses body name="target". -->
    <body name="target" pos="0.45 0 0.45" quat="0 1 0 0" mocap="true">
      <geom name="target_box" type="box" size="0.025 0.025 0.025" contype="0" conaffinity="0" rgba="0.6 0.3 0.3 0.35" group="1"/>
      <site name="target_site" type="sphere" size="0.007" rgba="0 0 1 1" group="1"/>
      <geom name="target_axis_x" type="capsule" fromto="0 0 0 0.09 0 0" size="0.003" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_y" type="capsule" fromto="0 0 0 0 0.09 0" size="0.003" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
      <geom name="target_axis_z" type="capsule" fromto="0 0 0 0 0 0.09" size="0.003" rgba="0 0.35 1 1" contype="0" conaffinity="0" group="1"/>
    </body>

    <!-- A small fixed table places objects above the robot base/floor and away from initial self-collision. -->
    <geom name="grasp_object_table" type="box" pos="0.62 0 0.160" size="0.17 0.24 0.020"
          material="object_table_mat" friction="2.0 0.08 0.005" condim="6" contype="1" conaffinity="1"/>

    <!-- Graspable cube: 4 cm edge. Table top is z=0.180, half-height is 0.020, plus 0.5 mm clearance. -->
    <body name="grasp_cube" pos="0.62 -0.075 0.2005" quat="0 1 0 0">
      <freejoint name="grasp_cube_freejoint"/>
      <geom name="grasp_cube_geom" type="box" size="0.020 0.020 0.020" material="grasp_cube_blue"
            mass="0.045" friction="4.0 0.12 0.01" condim="6" priority="1" contype="1" conaffinity="1"
            solref="0.012 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Graspable cylinder: 4 cm diameter, 5 cm height. Table top is z=0.180, half-height is 0.025, plus 0.5 mm clearance. -->
    <body name="grasp_cylinder" pos="0.62 0.075 0.2055" quat="0 1 0 0">
      <freejoint name="grasp_cylinder_freejoint"/>
      <geom name="grasp_cylinder_geom" type="cylinder" size="0.020 0.025" material="grasp_cylinder_orange"
            mass="0.040" friction="4.0 0.12 0.01" condim="6" priority="1" contype="1" conaffinity="1"
            solref="0.012 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
